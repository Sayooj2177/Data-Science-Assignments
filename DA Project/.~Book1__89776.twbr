            <column aggregate-role-from='[Customer City]' datatype='string' name='[Customer Region]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Revenue]' role='measure' type='quantitative' />
            <column caption='Warehouse Country' datatype='string' name='[Warehouse_Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_0655337272049665]' derivation='User' name='[usr:Calculation_0655337272049665:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0aflbum1iy372514lajhq0u5pqio].[Action (Customer Region)]'>
