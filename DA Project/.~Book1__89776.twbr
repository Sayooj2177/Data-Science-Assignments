    <worksheet name='Gross Margin'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#898989' fontsize='14'>Gross Margin</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Fact_Orders (DA DATA)' name='federated.0aflbum1iy372514lajhq0u5pqio' />
          </datasources>
          <datasource-dependencies datasource='federated.0aflbum1iy372514lajhq0u5pqio'>
            <column caption='Cogs' datatype='real' name='[COGS]' role='measure' type='quantitative' />
            <column caption='Gross Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0655337272049665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Revenue]) - SUM([COGS])) / SUM([Revenue])' />
