      <aliases enabled='yes' />
      <column caption='Actual Delivery Date' datatype='date' name='[Actual_Delivery_Date]' role='dimension' type='ordinal' />
      <column caption='Cogs' datatype='real' name='[COGS]' role='measure' type='quantitative' />
      <column caption='Gross Profit' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Calculation_0655337271414784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) - SUM([COGS])' />
      </column>
      <column caption='Gross Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0655337272049665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - SUM([COGS])) / SUM([Revenue])' />
      </column>
      <column caption='Stockout Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0655337327128578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Stockout_Flag])' />
      </column>
      <column caption='On-Time Flag' datatype='integer' name='[Calculation_0655337328111619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Actual_Delivery_Date] &lt;= [Promised_Delivery_Date] THEN&#10;    1&#10;ELSE&#10;    0&#10;END' />
      </column>
      <column caption='On-Time Delivery %' datatype='real' default-format='p0.00%' name='[Calculation_0655337328463876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0655337328111619])' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_0655337340440584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
