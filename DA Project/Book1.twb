            <column caption='On-Time Flag' datatype='integer' name='[Calculation_0655337328111619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Actual_Delivery_Date] &lt;= [Promised_Delivery_Date] THEN&#10;    1&#10;ELSE&#10;    0&#10;END' />
